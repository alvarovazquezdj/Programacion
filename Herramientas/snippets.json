	"Insertar ordenado": {
		"prefix": "insertar",
		"body": [
			"static int insertar(int[] numeros, int numElementos, int valor) {",
			"    if (numElementos < numeros.length) {",
			"        int i = numElementos - 1;",
			"        while (i >= 0 && numeros[i] > valor) {",
			"            numeros[i + 1] = numeros[i];",
			"            i--;",
			"        }",
			"        numeros[i + 1] = valor;",
			"        numElementos++;",
			"    }",
			"    return numElementos;",
			"}"
		],
		"description": "Insertar valor manteniendo orden ascendente"
	},
	"Eliminar elemento": {
		"prefix": "eliminar",
		"body": [
			"static int eliminar(int[] numeros, int numElementos, int valor) {",
			"    for (int i = 0; i < numElementos; i++) {",
			"        if (numeros[i] == valor) {",
			"            for (int j = i; j < numElementos - 1; j++) {",
			"                numeros[j] = numeros[j + 1];",
			"            }",
			"            numElementos--;",
			"            numeros[numElementos] = 0;",
			"            break;",
			"        }",
			"    }",
			"    return numElementos;",
			"}"
		],
		"description": "Eliminar primera aparición"
	},
