	"Ordenar menor a mayor": {
		"prefix": "ordenar",
		"body": [
			"static void ordenar(int[] numeros, int numElementos) {",
			"    for (int i = 0; i < numElementos - 1; i++) {",
			"        for (int j = 0; j < numElementos - 1 - i; j++) {",
			"            if (numeros[j] > numeros[j + 1]) {",
			"                int aux = numeros[j];",
			"                numeros[j] = numeros[j + 1];",
			"                numeros[j + 1] = aux;",
			"            }",
			"        }",
			"    }",
			"}"
		],
		"description": "Ordenar array ascendente mediante burbuja"
	},
